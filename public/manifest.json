{
  "name": "Routines",
  "short_name": "Routines",
  "description": "A quiet daily checklist",
  "start_url": "/routines/",
  "scope": "/routines/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "share_target": {
    "action": "/routines/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "backup",
          "accept": ["application/json", ".json", "text/plain", ".txt"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/routines/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/routines/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/routines/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/routines/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
