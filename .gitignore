# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite
/dist
dist-ssr
*.local

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Claude Code local state — most of .claude/ is local-only (dev-server
# launch config, task notes: personal/ephemeral, not meant for other
# contributors to read). The shared workflow (hooks, commands, hook wiring)
# and the pattern log (docs/patterns.md: verified facts about the codebase,
# meant to persist across sessions/clones/contributors, not scratch notes)
# are tracked so they ship with the repo as a blueprint.
/.claude/*
!/.claude/hooks/
!/.claude/commands/
!/.claude/settings.json
!/.claude/docs/
